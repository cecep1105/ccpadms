# Reverse proxy TERPADU -- satu pintu masuk (port 443/HTTPS + redirect dari
# 80/HTTP) utk Django (API, admin, WebSocket) & Next.js (semua halaman
# lain), supaya browser lihat SATU origin & TIDAK BUTUH CORS sama sekali
# antar keduanya.
#
# Routing:
#   /api/v1/*, /admin/*, /static/*  -> Django (daphne, port 8000)
#   /ws/*                            -> Django (WebSocket upgrade, port 8000)
#   /iclock/{cdata,getrequest,devicecmd} (EXACT) -> Django (PUSH SDK device fisik)
#   /*  (SISANYA)                    -> Next.js (port 3000)

# PENTING -- SEMUA "proxy_set_header Host" di file ini PAKAI $http_host,
# BUKAN $host: variabel $host nginx SECARA BAWAAN MEMBUANG port dari Host
# header asli (mis. browser kirim "namadomain:8443" -> $host jadi cuma
# "namadomain", TANPA port) -- kalau dipakai buat proxy_set_header Host,
# Django/Next.js DI BALIKNYA jadi terima Host TANPA PORT, bikin
# redirect/URL absolut yang mereka bangun (mis. NextAuth middleware
# redirect ke /login) SALAH PORT (defaultnya balik ke 443, bukan port
# host sungguhan yang dipetakan mis. 8443) -- reproducible, diuji
# langsung. $http_host TIDAK membuang apa pun, meneruskan Host PERSIS
# seperti yang browser kirim.
upstream django_upstream {
    server django-web:8000;
}

upstream nextjs_upstream {
    server nextjs:3000;
}

upstream djangodev_upstream {
    server ${DEV_SERVER_IP}:8000;
}

upstream nextjsdev_upstream {
    server ${DEV_SERVER_IP}:3000;
}


#1. SERVE NEXTJS FRONTEND - PRODUCTION
# --- Port 80: HANYA redirect ke HTTPS -- TIDAK proxy apa pun di sini,
# supaya SEMUA trafik (termasuk yang "lupa" ketik https://) tetap lewat
# jalur terenkripsi. ---
server {
    listen 80;
    server_name ${PROD_SERVER};

    # PENTING -- port di sini HARUS SAMA PERSIS dgn port HOST yang dipetakan
    # ke 443 container ini di docker-compose.yml (default "8443:443", lihat
    # baris `ports:` service nginx) -- GANTI ANGKA 8443 DI BAWAH KALAU
    # PORT HOST ANDA BEDA.
    #
    # KENAPA PORT HARUS DITULIS EKSPLISIT: variabel nginx $host SECARA
    # BAWAAN MEMBUANG port dari Host header request (mis. request ke
    # "namadomain:8036" -> $host jadi cuma "namadomain", TANPA :8036).
    # Kalau redirect di bawah cuma "https://$host$request_uri" (TANPA port
    # eksplisit), browser terima Location TANPA port -> browser pakai PORT
    # DEFAULT HTTPS (443) -- BUKAN 8443 yang sebenarnya dipetakan ke nginx
    # ini. Kalau domain Anda kebetulan PUNYA server lain yang listen di
    # port 443 asli (mis. reverse proxy production lama), browser malah
    # nyasar ke situ & gagal TLS handshake (ERR_SSL_PROTOCOL_ERROR) -- BUKAN
    # ke container nginx test-production ini sama sekali.
    return 301 https://$host:8043$request_uri;
}

server {
    listen 8043 ssl http2;
    server_name ${PROD_SERVER};

    # --- Sertifikat -- lihat docker/nginx/certs/README.md cara generate
    # (self-signed utk testing) ATAU pasang sertifikat asli (mis. Sectigo
    # yang sama dipakai production, atau Let's Encrypt kalau domain publik
    # sungguhan sudah mengarah ke sini). ---
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Pengaturan SSL yang wajar utk 2026 (TLS 1.2 minimal, cipher modern) --
    # cukup utk testing/internal, BUKAN audit keamanan penuh -- kalau nanti
    # benar2 public-facing, pertimbangkan cek ulang lewat
    # https://ssl-config.mozilla.org/ (pilih profil "Intermediate").
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 20M;  # foto wajah/attendance & upload fingerprint template bisa lumayan besar

    # --- Static files Django -- dilayani LANGSUNG nginx dari volume
    # bersama (JANGAN diproxy ke daphne, itu proses Python, tidak efisien
    # utk file statis) ---
    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # --- WebSocket (Channels, console real-time Active Device) ---
    location /ws/ {
        proxy_pass http://django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;  # koneksi WS boleh nganggur lama, jangan diputus nginx duluan
    }

    # --- API Django (v1) + Admin Django ---
    # PENTING: regex HARUS spesifik "api/v1", BUKAN "api" generik --
    # NextAuth (Next.js) punya rute internal sendiri di /api/auth/* (session,
    # providers, error, dst). Kalau regex-nya cuma "^/(api|admin)/", /api/auth/*
    # ikut ketangkap ke sini & diteruskan ke Django (yang tidak punya rute
    # itu) -> 404, NextAuth error total. Dengan "api/v1" spesifik, /api/auth/*
    # jatuh ke location "/" di bawah (Next.js) -- benar.
    location ~ ^/(api/v1|admin|media)/ {
        proxy_pass http://django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Endpoint PUSH SDK device fingerprint (root-level, lihat
    # config/urls.py & iclock/pushsdk_urls.py -- device firmware hardcoded
    # path /iclock/xxx, TIDAK bisa diubah ke /api/iclock/xxx).
    #
    # PENTING -- EXACT match (`=`), BUKAN prefix match (`/iclock/`): Next.js
    # JUGA punya halaman dashboard di path berawalan "/iclock/" (mis.
    # /iclock/active-devices, kebetulan nama sama krn app Django-nya juga
    # bernama "iclock"). Dengan EXACT match ke 3 path PERSIS ini, path lain
    # yang berawalan "/iclock/" jatuh ke location "/" (Next.js) -- benar.
    location = /iclock/cdata {
        proxy_pass http://django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # ORIGINIP -- lihat iclock/pushsdk_views.py::_resolve_request_ip,
        # dipakai skenario request-mirroring produksi (device asli ->
        # server lama -> di-mirror ke sini, REMOTE_ADDR bukan IP device
        # sebenarnya). Set header ini kalau setup mirroring dipakai:
        proxy_set_header X-Real-IP $arg_ORIGINIP;
    }
    location = /iclock/getrequest {
        proxy_pass http://django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /iclock/devicecmd {
        proxy_pass http://django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }



    # --- Next.js (SEMUA sisanya: dashboard, portal, mobile, login) ---
    location / {
        proxy_pass http://nextjs_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

